{
  "version": 1,
  "note": "入口契约真源。vite proxy / nginx / 冒烟脚本均由此文件驱动，禁止在他处重复声明分流规则。",

  "dev": {
    "port": 3000,
    "host": "0.0.0.0"
  },

  "upstreams": {
    "page-engine": {
      "desc": "Page Engine — 菜单 / 页面 Schema / RBAC（Rust + Axum）",
      "dev": "http://127.0.0.1:5300",
      "prod": "http://127.0.0.1:5300",
      "env": "VITE_PAGE_ENGINE_PROXY",
      "proxyHostHeader": "$host",
      "deployNote": "目标态：与门户同机。2026-09-12 阿里云勘察：47.115.168.107 仅监听 80/8080/22，尚未部署 PE。上线前须先部署，否则 /v1/menus|pages|permissions 会 502。"
    },
    "looma": {
      "desc": "Looma — 诗词 / RAG / 认证 / 支付（大陆入口）",
      "dev": "http://api.genz.ltd",
      "prod": "http://14.29.216.219",
      "env": "VITE_LOOMA_PROXY",
      "proxyHostHeader": "14.29.216.219",
      "deployNote": "prod 取天翼（大陆主写端）：2026-09-12 阿里云实测 11ms。api.genz.ltd 是海外同源实例（git_commit 相同），实测 1180ms，仅用于本地开发。线上 00-szbolent.conf 已按此选择。"
    },
    "looma-local": {
      "desc": "Looma 本机实例（api.genz.ltd 那台机器上的 :5200）",
      "dev": "http://127.0.0.1:5200",
      "prod": "http://127.0.0.1:5200",
      "proxyHostHeader": "$host"
    },
    "wordpress": {
      "desc": "WordPress headless — 博客 CMS",
      "dev": "http://localhost:8800",
      "prod": "http://127.0.0.1:8080",
      "env": "VITE_WP_PROXY",
      "proxyHostHeader": "$host"
    }
  },

  "routes": [
    { "prefix": "/v1/menus", "upstream": "page-engine", "desc": "菜单树（动态路由 + Header 数据源）" },
    { "prefix": "/v1/pages", "upstream": "page-engine", "desc": "页面 Schema（by-path / CRUD）" },
    { "prefix": "/v1/permissions", "upstream": "page-engine", "desc": "RBAC 权限查询与校验" },
    { "prefix": "/v1", "upstream": "looma", "desc": "诗词 / RAG / 认证 / 支付（兜底，须最后声明）" },
    { "prefix": "/wp-json", "upstream": "wordpress", "desc": "博客 REST 通道" },
    { "prefix": "/wp-login.php", "upstream": "wordpress", "desc": "WP 登录入口" },
    { "prefix": "/wp-admin", "upstream": "wordpress", "desc": "WP 后台" },
    { "prefix": "/wp-content", "upstream": "wordpress", "desc": "WP 上传与主题资源" },
    { "prefix": "/wp-includes", "upstream": "wordpress", "desc": "WP 核心资源" }
  ],

  "sites": {
    "portal": {
      "file": "nginx.conf",
      "desc": "门户入口 — 阿里云 47.115.168.107",
      "listen": 80,
      "defaultServer": true,
      "serverNames": [
        "_",
        "47.115.168.107",
        "szbolent.com.cn",
        "www.szbolent.com.cn",
        "bolent.cn",
        "www.bolent.cn"
      ],
      "installPath": "/etc/nginx/conf.d/00-szbolent.conf",
      "installNote": "线上生效文件名是 00-szbolent.conf（00- 前缀抢先加载，default_server 归门户）。2026-09-12 勘察：deploy.sh 原本装成 szbolent.conf，与生效文件是两个名字，会留下重复 server_name —— 已改为装 00-szbolent.conf。",
      "reservedDomains": {
        "szbolent.cn": "poetries-h5（★ 诗词 H5）",
        "www.szbolent.cn": "poetries-h5 —— 其入口配置 /etc/nginx/conf.d/szbolent-h5.conf 不在本仓，门户不得声明这两个域名，否则抢站"
      },
      "clientMaxBodySize": "64m",
      "gzip": true,
      "defaultLocation": {
        "mode": "upstream",
        "upstream": "wordpress",
        "staticRoot": "/var/www/szbolent-portal/dist",
        "switchNote": "mode: upstream → WP 内容站（现状）；mode: static → 门户 SPA 产物接管的切换点。改这里 + 重新生成即可。"
      }
    },
    "api": {
      "file": "nginx-api.genz.ltd.conf",
      "desc": "api.genz.ltd — Looma API 后端入口（1.14.202.161）",
      "listen": 80,
      "defaultServer": false,
      "serverNames": ["api.genz.ltd"],
      "allToUpstream": "looma-local"
    }
  }
}
