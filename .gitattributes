*.json        text eol=lf
*.mjs         text eol=lf
*.js          text eol=lf
*.cjs         text eol=lf
*.ts          text eol=lf
*.vue         text eol=lf
*.md          text eol=lf
*.css         text eol=lf
*.scss        text eol=lf
*.html        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.toml        text eol=lf
*.xml         text eol=lf

