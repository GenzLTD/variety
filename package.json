{
  "name": "szbolent-portal",
  "version": "0.1.0",
  "type": "module",
  "description": "szbolent.com 智能化诗词门户 — Vue3 + Headless WP + AI 诗词",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-core.mjs && node scripts/prerender-bookstore.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "menus:gen": "node scripts/gen-menus.mjs",
    "menus:check": "node scripts/gen-menus.mjs --check",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "sync:setup": "bash scripts/sync-remotes.sh setup",
    "sync:push": "bash scripts/sync-remotes.sh push",
    "sync:check": "bash scripts/sync-remotes.sh check",
    "sync:force": "bash scripts/sync-remotes.sh force",
    "deploy": "bash scripts/deploy.sh",
    "smoke:local": "bash scripts/smoke-local.sh",
    "verify:offline": "bash scripts/verify-offline.sh",
    "verify:prod": "bash scripts/verify-prod.sh",
    "verify:nav": "node scripts/verify-nav-render.mjs",
    "verify:book": "node scripts/verify-bookstore.mjs",
    "map:shelf": "node scripts/map-bolent-shelf-feed.mjs",
    "prerender:bookstore": "node scripts/prerender-bookstore.mjs",
    "prerender:core": "node scripts/prerender-core.mjs",
    "verify:geo-p0": "node scripts/verify-geo-p0.mjs",
    "verify:geo-p1": "node scripts/verify-geo-p1.mjs",

    "report:prod": "bash scripts/report-prod.sh",
    "rotate:db": "bash scripts/rotate-db-password.sh",
    "report:db-env": "bash scripts/report-db-env.sh"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "axios": "^1.6.5",
    "dayjs": "^1.11.10",
    "dompurify": "^3.4.13",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.1.7",
    "swiper": "^11.0.5",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-onboarding": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/vue3-vite": "^10.4.6",
    "@types/aos": "^3.0.7",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.11.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "playwright": "^1.61.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rollup": "^4.9.6",
    "sass": "^1.70.0",
    "storybook": "^10.4.6",
    "typescript": "~5.6.3",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.12",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
