# szbolent-portal — 生产环境变量
# 目标域名 szbolent.com。备案证书尚未装到新机，流水线先只提供 HTTP。
# 证书落到 /etc/letsencrypt/live/szbolent.com/ 之后再开 443。

VITE_SITE_URL=https://szbolent.com
# 留空：浏览器请求同源 /v1，由本机 nginx 转到 127.0.0.1:5200。
# 不要填 https://api.genz.ltd，那会让浏览器跨域直连海外。
VITE_LOOMA_API_BASE=
VITE_BLOG_API_BASE=/wp-json/wp/v2
# 留相对路径：nginx 把 /wp-json 转到法兰克福书店。不要写 szbolent.cn。
VITE_SHELF_API_BASE=/wp-json/bookstore/v1
VITE_TATHA_POETRY_ENABLED=false

# 增长型门户 CTA
VITE_PLANETX_URL=https://app.genz.ltd
VITE_PLANETX_REF_CODE=
VITE_DEMOPPI_URL=
