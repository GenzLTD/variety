# variety — 生产环境变量
# 部署到官网 www.szbolent.com 时使用（TLS 由 acme.sh 签发，certDir=/etc/nginx/ssl/szbolent.com）

VITE_SITE_URL=https://www.szbolent.com
# looma 调用必须同源（留空 = 走门户自己的 nginx /v1 分流）：
#   —— 2026-10-09 起：全部 /v1/* → api.genz.ltd（location /v1 兜底，entry.json 中唯一的 /v1 路由）
#   原指向 page-engine（127.0.0.1:5300）的三条路由已全部清除：
#     /v1/menus        —— #12（菜单烘焙进构建）
#     /v1/pages        —— #13
#     /v1/permissions  —— #13
#   清除理由：5300 从未纳入部署流水线，且 nginx 最长前缀匹配会把 /v1/permissions/*
#   从 looma 兜底里劫走，静默打到不存在的后端。
# 2026-09-28 实测教训：填 https://api.genz.ltd 会让浏览器直连 looma，
# 而 looma 没有 /v1/menus（返回 404 not_found）→ 顶部导航空。
# 更糟的是「门户自身 /v1/menus」与「浏览器实际请求」是两条不同链路，
# 修好前者仍会得到全绿验收 + 用户看不到菜单的假绿（见 verify-prod.sh 第 6 节回归断言）。
VITE_LOOMA_API_BASE=
VITE_BLOG_API_BASE=/wp-json/wp/v2
# 书店 feed —— 单机部署（2026-11-08 起）：WordPress 与门户同机，
# 由 nginx 内部组网 /wp-json → 127.0.0.1:8080（contracts/entry.json 的 wordpress 上游）。
# 必须留**相对路径**（同源）：写绝对 URL 会变成跨域请求，还会把生产绑死在另一台机器上。
VITE_SHELF_API_BASE=/wp-json/bookstore/v1
VITE_TATHA_POETRY_ENABLED=false

# 增长型门户 CTA
VITE_PLANETX_URL=https://app.genz.ltd
VITE_PLANETX_REF_CODE=
VITE_DEMOPPI_URL=
