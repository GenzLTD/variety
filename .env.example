# szbolent-portal — 环境变量模板
# 复制为 .env.local 后修改（勿提交密钥）

# 门户公网地址（SEO / OG 用）
VITE_SITE_URL=http://localhost:3000

# Looma 商业/API 真源
# 本地留空 → vite proxy /v1 → api.genz.ltd（可用 VITE_LOOMA_PROXY 覆盖）
# 若直连远端（不经 proxy），填：https://api.genz.ltd —— 注意此时勿把 menus 打到远端
VITE_LOOMA_API_BASE=

# WordPress REST API（Poetry-modown headless）
# 开发时 vite 已代理 /wp-json → :8800
VITE_BLOG_API_BASE=/wp-json/wp/v2

# 书店 feed（同源 /wp-json/bookstore/v1；生产由 nginx 转到法兰克福 WP）
# 只取节选；卡片跳转 items[].url 回原文，不拉 /poem/<id> 全文
# 本地可直连：VITE_SHELF_API_BASE=https://szbolent.com/wp-json/bookstore/v1
VITE_SHELF_API_BASE=/wp-json/bookstore/v1

# ── 构建期 prerender（scripts/prerender-bookstore.mjs）──
# myblog 直连（bolent-shelf/v1 会自动适配为 bookstore/v1 形状）：
# BOOKSTORE_FEED_URL=http://myblog.szbolent.local/wp-json/bolent-shelf/v1/feed?limit=100
# myblog 挂着时用已提交快照（默认回落 scripts/fixtures/bolent-shelf-feed.json）：
# BOOKSTORE_FEED_FILE=scripts/fixtures/bolent-shelf-feed.json
# URL 映射：poem（默认 → /poem/<id>）| document（→ /blog/<slug>）| permalink
# BOOKSTORE_URL_MODE=poem
# BOOKSTORE_DEFAULT_GENRE=文

# ── 增长型门户 CTA（docs/GROWTH_PORTAL_NAMING.md）──
# PlanetX 裂变主路径落点（默认 app.genz.ltd）
VITE_PLANETX_URL=https://app.genz.ltd
# 运营/博主 referral code（可选）
# 正式推荐留空：PlanetX 落地端尚未消费 ?ref=，带码无归因；且 Looma /use 为一次性
# 非空仅用于验收拼 URL；见 docs/GROWTH_PORTAL_NAMING.md §8.2
VITE_PLANETX_REF_CODE=
# DemoPPI 共识增强层（独立域；空则博客详情不展示次 CTA）
VITE_DEMOPPI_URL=
